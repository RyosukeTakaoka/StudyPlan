{
  "name": "studyplan-mcp",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:authless": "wrangler dev --env authless",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply studyplan --local",
    "db:migrate:remote": "wrangler d1 migrations apply studyplan --remote",
    "token:new": "node scripts/new-device-token.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types --no-warnings test/*.test.ts",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.3",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "agents": "^0.29.0",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261021.1",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "wrangler": "^4.151.3"
  }
}
